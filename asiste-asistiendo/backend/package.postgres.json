{
  "name": "facial-auth-backend-postgres",
  "version": "1.0.0",
  "description": "Sistema de Autenticación Facial - Backend con PostgreSQL",
  "main": "server.postgres.js",
  "scripts": {
    "start": "node server.postgres.js",
    "dev": "nodemon server.postgres.js",
    "db:sync": "node -e \"require('./config/database').syncDatabase(false)\"",
    "db:reset": "node -e \"require('./config/database').syncDatabase(true)\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
